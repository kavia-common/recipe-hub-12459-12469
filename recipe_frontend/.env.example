# Frontend environment configuration for Recipe Hub (Create React App)
# IMPORTANT: Values are read at build time. Rebuild after changing.

# Base URL of the backend API (no trailing slash). Required.
# e.g., http://localhost:3001
REACT_APP_API_BASE_URL=

# Optional router basename if the app is served from a sub-path, e.g., /app
REACT_APP_ROUTER_BASENAME=/
