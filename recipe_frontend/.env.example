# PUBLIC INTERFACE: Environment variables required by the Recipe Frontend
# Copy this file to `.env` and set appropriate values for your environment.

# Base URL for the backend API (e.g., http://localhost:3001 or https://api.example.com)
REACT_APP_API_BASE_URL=http://localhost:3001

# If the app is served behind a subpath, you can set the basename for the router (optional)
REACT_APP_ROUTER_BASENAME=/
