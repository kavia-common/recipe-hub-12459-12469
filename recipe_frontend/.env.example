# Required
# Base URL of the backend API (no trailing slash)
# Examples:
#   Local dev: http://localhost:3001
#   CI/Preview: https://vscode-internal-31111-qa.qa01.cloud.kavia.ai:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# Optional
# If the frontend is served from a sub-path, set the router basename (e.g., /app).
# Defaults to "/"
REACT_APP_ROUTER_BASENAME=/

# Optional (backend handles provider keys; not read by the frontend)
# REACT_APP_PERPLEXITY_API_KEY is not required by the frontend; the backend should hold the provider API key.
# This line is here only for reference if you decide to surface any frontend flags later.
# REACT_APP_PERPLEXITY_API_KEY=
