# Environment variables for Recipe Hub frontend (React / Create React App)
# Copy this file to `.env` in the same directory and fill in the values.

# Base URL of the backend API (no trailing slash). Required.
# Example for local dev: http://localhost:3001
# Example for deployment: https://api.example.com
REACT_APP_API_BASE_URL=http://localhost:3001

# Optional: If the frontend is served from a sub-path, set the router basename.
# For most setups this should be "/".
REACT_APP_ROUTER_BASENAME=/
