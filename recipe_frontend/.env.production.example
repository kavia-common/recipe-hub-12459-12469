# Production example for CRA build-time env
# Required: backend base URL (no trailing slash)
REACT_APP_API_BASE_URL=https://vscode-internal-31111-qa.qa01.cloud.kavia.ai:3001

# Optional: router basename (default "/")
REACT_APP_ROUTER_BASENAME=/

# Optional: speed up CRA builds in CI and reduce memory usage
#GENERATE_SOURCEMAP=false
